        "npm": "11.9.x"
    },
    "imports": {
        "#varmateo/*": {
            "default": "./dist/varmateo/*.js"
        }
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.9.2",
        "chai": "^6.2.2",
        "html-webpack-plugin": "^5.6.7",
        "mocha": "^11.7.6",
        "ts-loader": "^9.6.0",
        "ts-node": "^10.9.2",
