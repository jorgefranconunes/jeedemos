{
    "name": "helloworld",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "scripts": {
        "build": "rm -rf ./dist && parcel build --public-url './' ./src/main/assets/index.html",
        "check": "tsc --noEmit --pretty false",
        "start": "rm -rf ./dist && parcel ./src/main/assets/index.html",
        "test": "npm run test-build && npm run test-run",
        "test-build": "rm -rf ./dist && tsc --outDir ./dist",
        "test-run": "mocha --ui tdd './src/test/typescript/**/*.test.ts'"
    },
    "keywords": [],
    "author": "Jorge Nunes <jorgefranconunes@gmail.com>",
    "license": "GPL-3.0-only",
    "engines": {
        "node": ">=24.14 <25",
        "npm": "> 11.9.x"
    },
    "imports": {
        "#varmateo/*": {
            "default": "./dist/varmateo/*.js"
        }
    },
    "devDependencies": {
        "@parcel/transformer-typescript-tsc": "^2.16.4",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "chai": "^6.2.2",
        "mocha": "^11.7.6",
        "parcel": "^2.16.4",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "mocha": {
        "require": [
            "ts-node/register"
        ]
    }
}
